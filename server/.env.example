# Copy this file to .env and fill in the keys you have. Providers without a
# key are disabled. Never commit .env.

PORT=8080

# The server listens on every network interface by default, so phones on
# your Wi-Fi can reach it. Uncomment to accept connections from this machine
# only; the web build, the iOS simulator and the Android emulator still work.
# HOST=127.0.0.1

OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Optional model overrides. The defaults are shown.
# OPENAI_MODEL=gpt-6.1-sol
# GEMINI_MODEL=gemini-3.8-flash
# CLAUDE_MODEL=claude-opus-5-5

# Optional system prompt for every conversation.
# SYSTEM_PROMPT=You are a helpful assistant.

# By default a "system" field sent by the app replaces SYSTEM_PROMPT. Set this
# to false in production so callers cannot remove your instructions.
# ALLOW_CLIENT_SYSTEM_PROMPT=false

# Restrict browser access to your web app's origin in production.
# ALLOWED_ORIGIN=https://chat.example.com
